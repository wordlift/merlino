@prefix aooe:   <https://example.org/aooe#> .
@prefix mr:     <https://example.org/merlin-railroad#> .
@prefix schema: <https://schema.org/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# MERLIN RAILROAD: The executable state space for running coaching.
# States (9), Actions (10), Roles (2), Evidence (3), Permitted Transitions.
# Built on AOOE principles: constraint-bounded, gate-verified, provable.
# ---------------------------------------------------------------------------

# ---------- Roles ----------
mr:Merlin a aooe:AgentRole ;
    rdfs:label "Merlin (coach agent)" ;
    skos:definition "The autonomous AI running coach assisting with planning, analysis and monitoring." .

mr:Runner a aooe:AgentRole , aooe:HumanRole ;
    rdfs:label "Runner (human athlete)" ;
    skos:definition "The human runner who approves training plans, logs workouts, answers check-ins, and closes the week." .

# ---------- States (9) ----------
mr:Start a aooe:State ;
    rdfs:label "Start" ;
    aooe:isInitial true ;
    skos:definition "Initial state. Runner profile and goal race are designated; run history is yet to be read." .

mr:BaselineKnown a aooe:State ;
    rdfs:label "Baseline known" ;
    skos:definition "Recent running history and weekly mileage baseline have been retrieved and verified." .

mr:PlanProposed a aooe:State ;
    rdfs:label "Plan proposed" ;
    skos:definition "A candidate training plan for the upcoming week has been generated by Merlin." .

mr:PlanApproved a aooe:State ;
    rdfs:label "Plan approved" ;
    skos:definition "The runner has formally reviewed and approved the specific training plan." .

mr:WeekInProgress a aooe:State ;
    rdfs:label "Week in progress" ;
    skos:definition "The training week is underway; runner logs sessions as they are completed." .

mr:AwaitingCheckIn a aooe:State ;
    rdfs:label "Awaiting check-in" ;
    skos:definition "Merlin has requested subjective athlete feedback regarding fatigue, sleep, and pain." .

mr:WeekReviewed a aooe:State ;
    rdfs:label "Week reviewed" ;
    skos:definition "Weekly training mileage, adherence, and check-in responses have been evaluated." .

mr:WeekClosed a aooe:State ;
    rdfs:label "Week closed" ;
    aooe:isTerminal true ;
    skos:definition "Terminal state. The training cycle for the week is successfully concluded and archived." .

mr:HandedToHuman a aooe:State ;
    rdfs:label "Handed to a human" ;
    aooe:isTerminal true ;
    skos:definition "Terminal state. The agent has safely escalated the workflow to a human coach, clinician, or runner." .

# ---------- Evidence Classes (3) ----------
mr:RunHistory a rdfs:Class ;
    rdfs:subClassOf aooe:Evidence ;
    rdfs:label "Run history" ;
    skos:definition "Aggregated historical run data containing data age in days and previous week's total distance in km." .

mr:CheckIn a rdfs:Class ;
    rdfs:subClassOf aooe:Evidence ;
    rdfs:label "Athlete check-in" ;
    skos:definition "Subjective feedback submitted by the runner detailing perceived exertion, sleep quality, and pain status." .

mr:PlanApproval a rdfs:Class ;
    rdfs:subClassOf aooe:Evidence ;
    rdfs:label "Plan approval" ;
    skos:definition "Explicit cryptographic or digital confirmation from the runner approving one specific training plan." .

# ---------- Domain Properties ----------
mr:dataAgeDays      a rdf:Property ; rdfs:label "data age in days" .
mr:lastWeekKm       a rdf:Property ; rdfs:label "last week total km" .
mr:plannedKm        a rdf:Property ; rdfs:label "planned total km" .
mr:hasPain          a rdf:Property ; rdfs:label "has pain flag" .
mr:painDetails      a rdf:Property ; rdfs:label "pain details" .
mr:perceivedEffort  a rdf:Property ; rdfs:label "perceived effort score" .
mr:sleepQuality     a rdf:Property ; rdfs:label "sleep quality score" .
mr:approvesPlan     a rdf:Property ; rdfs:label "approves exercise plan" .
mr:targetPlan       a rdf:Property ; rdfs:label "target exercise plan" .
mr:isHard           a rdf:Property ; rdfs:label "is hard session flag" .
mr:workoutType      a rdf:Property ; rdfs:label "workout type" .
mr:dayOfWeek        a rdf:Property ; rdfs:label "day of week" .
mr:dayNumber        a rdf:Property ; rdfs:label "numeric day of week (1=Mon, 7=Sun)" .
mr:session          a rdf:Property ; rdfs:label "training session" .

# ---------- Actions (10) ----------
mr:ReadRunHistory a aooe:Action ;
    rdfs:label "Read run history" ;
    aooe:tool "read_run_history" ;
    aooe:allowedRole mr:Merlin ;
    aooe:producesEvidence mr:RunHistory ;
    skos:definition "Retrieve recent activity data and calculate mileage baseline and freshness." .

mr:ProposePlan a aooe:Action ;
    rdfs:label "Propose plan" ;
    aooe:tool "propose_plan" ;
    aooe:allowedRole mr:Merlin ;
    aooe:requiresEvidence mr:RunHistory ;
    skos:definition "Synthesize an upcoming 7-day training plan adhering to mileage progressions and workout distribution." .

mr:ApprovePlan a aooe:Action ;
    rdfs:label "Approve plan" ;
    aooe:tool "approve_plan" ;
    aooe:allowedRole mr:Runner ;
    aooe:producesEvidence mr:PlanApproval ;
    skos:definition "Human runner reviews proposed sessions and signs off with a PlanApproval evidence token." .

mr:StartWeek a aooe:Action ;
    rdfs:label "Start week" ;
    aooe:tool "start_week" ;
    aooe:allowedRole mr:Merlin ;
    aooe:requiresEvidence mr:PlanApproval ;
    aooe:isIrreversible true ;
    skos:definition "Irreversible commitment. Commits calendar slots, schedules notifications, and locks the weekly training target." .

mr:LogRun a aooe:Action ;
    rdfs:label "Log run" ;
    aooe:tool "log_run" ;
    aooe:allowedRole mr:Runner ;
    skos:definition "Runner uploads or confirms completion of an individual exercise action." .

mr:AskCheckIn a aooe:Action ;
    rdfs:label "Ask check-in" ;
    aooe:tool "ask_check_in" ;
    aooe:allowedRole mr:Merlin ;
    skos:definition "Prompt the runner for subjective recovery, soreness, and physiological feedback." .

mr:AnswerCheckIn a aooe:Action ;
    rdfs:label "Answer check-in" ;
    aooe:tool "answer_check_in" ;
    aooe:allowedRole mr:Runner ;
    aooe:producesEvidence mr:CheckIn ;
    skos:definition "Human runner submits check-in scores for effort, sleep, and presence of musculoskeletal pain." .

mr:ReviewWeek a aooe:Action ;
    rdfs:label "Review week" ;
    aooe:tool "review_week" ;
    aooe:allowedRole mr:Merlin ;
    aooe:requiresEvidence mr:CheckIn ;
    skos:definition "Analyze completed mileage vs. target and assess athlete recovery readiness." .

mr:CloseWeek a aooe:Action ;
    rdfs:label "Close week" ;
    aooe:tool "close_week" ;
    aooe:allowedRole mr:Runner ;
    skos:definition "Runner seals the weekly cycle, allowing archival and progression to the subsequent cycle." .

mr:HandToHuman a aooe:Action ;
    rdfs:label "Hand to a human" ;
    aooe:tool "hand_to_human" ;
    aooe:allowedRole mr:Merlin , mr:Runner ;
    skos:definition "Escalate workflow to a human coach, medical specialist, or direct manual control." .

# ---------- Transitions (The Rails) ----------
# Main progression path:
mr:t1 a aooe:Transition ; aooe:fromState mr:Start ;           aooe:viaAction mr:ReadRunHistory ; aooe:toState mr:BaselineKnown .
mr:t2 a aooe:Transition ; aooe:fromState mr:BaselineKnown ;   aooe:viaAction mr:ProposePlan ;    aooe:toState mr:PlanProposed .
mr:t3 a aooe:Transition ; aooe:fromState mr:PlanProposed ;    aooe:viaAction mr:ApprovePlan ;    aooe:toState mr:PlanApproved .
mr:t4 a aooe:Transition ; aooe:fromState mr:PlanApproved ;    aooe:viaAction mr:StartWeek ;      aooe:toState mr:WeekInProgress .
mr:t5 a aooe:Transition ; aooe:fromState mr:WeekInProgress ;  aooe:viaAction mr:LogRun ;         aooe:toState mr:WeekInProgress .
mr:t6 a aooe:Transition ; aooe:fromState mr:WeekInProgress ;  aooe:viaAction mr:AskCheckIn ;     aooe:toState mr:AwaitingCheckIn .
mr:t7 a aooe:Transition ; aooe:fromState mr:AwaitingCheckIn ; aooe:viaAction mr:AnswerCheckIn ;  aooe:toState mr:WeekInProgress .
mr:t8 a aooe:Transition ; aooe:fromState mr:WeekInProgress ;  aooe:viaAction mr:ReviewWeek ;     aooe:toState mr:WeekReviewed .
mr:t9 a aooe:Transition ; aooe:fromState mr:WeekReviewed ;    aooe:viaAction mr:CloseWeek ;      aooe:toState mr:WeekClosed .

# Adaptive loops (repairs, re-planning, in-flight logging):
mr:t10 a aooe:Transition ; aooe:fromState mr:PlanProposed ;   aooe:viaAction mr:ProposePlan ;    aooe:toState mr:PlanProposed .
mr:t11 a aooe:Transition ; aooe:fromState mr:PlanApproved ;   aooe:viaAction mr:ProposePlan ;    aooe:toState mr:PlanProposed .
mr:t12 a aooe:Transition ; aooe:fromState mr:PlanApproved ;   aooe:viaAction mr:ApprovePlan ;    aooe:toState mr:PlanApproved .
mr:t13 a aooe:Transition ; aooe:fromState mr:AwaitingCheckIn; aooe:viaAction mr:LogRun ;         aooe:toState mr:AwaitingCheckIn .

# Safety exits: Hand to a human reachable from every non-terminal state after Start:
mr:t14 a aooe:Transition ; aooe:fromState mr:BaselineKnown ;   aooe:viaAction mr:HandToHuman ; aooe:toState mr:HandedToHuman .
mr:t15 a aooe:Transition ; aooe:fromState mr:PlanProposed ;    aooe:viaAction mr:HandToHuman ; aooe:toState mr:HandedToHuman .
mr:t16 a aooe:Transition ; aooe:fromState mr:PlanApproved ;    aooe:viaAction mr:HandToHuman ; aooe:toState mr:HandedToHuman .
mr:t17 a aooe:Transition ; aooe:fromState mr:WeekInProgress ;  aooe:viaAction mr:HandToHuman ; aooe:toState mr:HandedToHuman .
mr:t18 a aooe:Transition ; aooe:fromState mr:AwaitingCheckIn ; aooe:viaAction mr:HandToHuman ; aooe:toState mr:HandedToHuman .
mr:t19 a aooe:Transition ; aooe:fromState mr:WeekReviewed ;    aooe:viaAction mr:HandToHuman ; aooe:toState mr:HandedToHuman .
